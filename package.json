{
  "name": "jitsi-videoconference-plugin",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration=dev",
    "build:live": "ng build --configuration=live",
    "postbuild": "node scripts/seo-postbuild.mjs && node scripts/csp-sources.mjs",
    "postbuild:dev": "npm run postbuild",
    "postbuild:live": "npm run postbuild",
    "local-build": "ng build --base-href $BASE_HREF",
    "watch": "ng build --watch --configuration dev",
    "test": "ng test",
    "deploy": "node deploy.js --endpoint http://localhost:9000",
    "deploy:aws": "node deploy.js --endpoint https://s3.amazonaws.com",
    "build-and-deploy": "npm run build && npm run deploy"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/ssr": "^21.2.26",
    "@aws-sdk/client-s3": "^3.700.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "mime-types": "^2.1.35",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "~21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@spartan-ng/cli": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mime-types": "^2.1.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
