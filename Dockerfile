# nginxinc/nginx-unprivileged runs the master and worker processes as the
# non-root "nginx" user (uid 101), unlike the stock nginx image. A non-root
# user can't bind ports below 1024, so nginx.conf listens on 8080 (HTTP, which
# only redirects) and 8443 (HTTPS).
FROM nginxinc/nginx-unprivileged:1.31.4-alpine

# Build the site before building the image; ci/build-dev.sh and
# ci/build-live.sh do both:
#   npm run build:dev                   -> dev
#   npm run build / npm run build:live  -> live
# Every environment-specific value (apiUrl, siteUrl, cdnUrl, indexable) comes
# from the committed src/environments/environment.<env>.ts and is baked in at
# build time, so each image serves exactly one environment.
#
# browser/ holds the pre-rendered site: index.html (home), <route>/index.html
# for each pre-rendered route, and index.csr.html (the shell nginx falls back
# to for any other path). The postbuild step (scripts/seo-postbuild.mjs) adds
# robots.txt, plus sitemap.xml and the IndexNow key file for indexable builds.
COPY dist/toab-jitsi-website/browser /usr/share/nginx/html

# The build-specific parts of the Content-Security-Policy, generated by
# scripts/csp-sources.mjs during postbuild: hashes of the inline scripts and
# handlers in the pre-rendered pages, and the CDN and API origins read back
# from them. nginx.conf includes this file, so the CSP always matches the build
# in the image.
COPY dist/toab-jitsi-website/nginx/csp-sources.conf /etc/nginx/snippets/csp-sources.conf

# Copied as-is: nothing in it is substituted at container start, so the image
# needs no environment variables to run.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# The TLS certificate and key are not baked in: the image is pushed to
# ghcr.io, and a key in an image layer is readable by anyone who can pull it.
# Mount them read-only at /etc/nginx/tls under the names nginx.conf expects,
# example.com+5.pem and example.com+5-key.pem, e.g.
#   docker run -p 8443:8443 -v "$PWD/tls:/etc/nginx/tls:ro" <image>

EXPOSE 8080 8443
